API_ID=
API_HASH=
BOT_TOKEN=

WATCHHENTAI_BASE_URL=https://watchhentai.net

# Local SQLite database. For a Render Persistent Disk, use:
# WH_DB_PATH=/data/watchhentai.db
WH_DB_PATH=./data/watchhentai.db

# Temporary downloads. For a Render Persistent Disk, use:
# DOWNLOAD_DIR=/data/downloads
DOWNLOAD_DIR=./downloads

# Telegram channel publishing
# Example: @my_channel or -1001234567890
CHANNEL_ID=
TELEGRAM_CHANNEL_INTERVAL=1.2

# Render/background scheduler
SCHEDULER_ENABLED=true
CRAWL_INTERVAL=1800
CRAWL_PAGES=1
PUBLISH_LIMIT=20

# Set to 121 for the first deployment if you want the full catalog
# imported automatically in the background.
INITIAL_CRAWL_PAGES=0
