API_ID=
API_HASH=
BOT_TOKEN=

WATCHHENTAI_BASE_URL=https://watchhentai.net

# For Railway with a volume mounted at /app/data:
WH_DB_PATH=/app/data/watchhentai.db
DOWNLOAD_DIR=/app/data/downloads

CHANNEL_ID=
# Channel where /download publishes the series header and episode videos.
DOWNLOAD_CHANNEL_ID=
TELEGRAM_CHANNEL_INTERVAL=1.2

SCHEDULER_ENABLED=true
CRAWL_INTERVAL=1800
CRAWL_PAGES=1
PUBLISH_LIMIT=20

# Leave 0 after the initial import.
# Set to 121 once if you want Railway to perform the full initial crawl.
INITIAL_CRAWL_PAGES=0
